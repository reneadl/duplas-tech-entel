---
const faqs = [
  {
    q: "¿El programa tiene algún costo?",
    a: "No, es completamente gratuito para los seleccionados gracias al apoyo de Entel a través del Fondo 55+.",
  },
  {
    q: "¿Necesito ser experto en programación para postular?",
    a: "No es necesario ser experto, pero sí tener educación media completa y manejo fluido de computador. No es un programa para aprender a usar el computador desde cero.",
  },
  {
    q: "¿Puedo participar si no vivo en Santiago?",
    a: "La Etapa 1 es 100% online. Sin embargo, la Etapa 2 requiere asistencia a hitos presenciales en la Región Metropolitana o Valparaíso.",
  },
  {
    q: "¿Cuándo cierran las postulaciones?",
    a: "El 31 de mayo de 2026. Te recomendamos completar el formulario apenas se abra la convocatoria el 18 de mayo.",
  },
  {
    q: "¿Cómo se forman las duplas?",
    a: "Tras la Etapa 1, los 60 Seniors más destacados son emparejados con 60 Jóvenes Colaboradores en función de afinidad de intereses y áreas de proyecto.",
  },
  {
    q: "¿Dónde puedo hacer más consultas?",
    a: "Escríbenos directamente a duplas_inter@desafiolatam.com y te responderemos a la brevedad.",
  },
];
---

<section id="faq" class="bg-white border-b border-border scroll-mt-16">
  <div class="max-w-300 mx-auto px-6 sm:px-8 lg:px-12 py-16 lg:py-20">
    <div class="max-w-3xl mb-10">
      <div class="text-xs font-semibold uppercase tracking-wide text-orange mb-3">Preguntas frecuentes</div>
      <h2 class="font-semibold text-2xl lg:text-3xl text-ink leading-tight">
        Resolvemos tus <strong class="font-bold text-entel">dudas</strong>
      </h2>
    </div>

    <div class="max-w-3xl bg-white border border-border rounded-xl divide-y divide-border">
      {
        faqs.map(({ q, a }) => (
          <details class="group p-5">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none">
              <span class="font-semibold text-ink text-sm lg:text-base">{q}</span>
              <span class="shrink-0 w-6 h-6 text-muted transition-transform duration-200 group-open:rotate-45">
                <svg class="w-full h-full" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
              </span>
            </summary>
            <p class="mt-3 text-sm text-muted leading-relaxed">{a}</p>
          </details>
        ))
      }
    </div>

    <div class="mt-8 text-sm text-muted">
      ¿Tienes otra duda? Escríbenos a <a href="mailto:duplas_inter@desafiolatam.com" class="text-entel font-semibold hover:underline">duplas_inter@desafiolatam.com</a>
    </div>
  </div>
</section>
