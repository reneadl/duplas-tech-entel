---
---

<section id="inicio" class="bg-white border-b border-border">
  <div class="max-w-300 mx-auto px-6 sm:px-8 lg:px-12 py-16 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-[1.618fr_1fr] gap-12 lg:gap-16 items-center">
      <!-- Columna mayor (φ) — contenido -->
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-semibold text-entel bg-entel/8 px-3 py-1.5 rounded-full mb-6">
          Alianza Entel + Desafío Latam · 2026
        </div>

        <h1 class="font-bold text-3xl md:text-4xl lg:text-5xl text-ink leading-tight mb-5">
          Duplas Intergeneracionales Tech
        </h1>

        <p class="text-base lg:text-lg text-muted leading-relaxed mb-8 max-w-2xl">
          Programa <strong class="text-ink">100% gratuito</strong> para potenciar tu empleabilidad y dominar la Inteligencia Artificial. Conecta con otras generaciones, financiado por el Fondo 55+ Entel.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 mb-10">
          <a
            href="#postulacion"
            class="bg-orange text-white font-semibold text-sm px-6 py-3 rounded-md text-center transition-colors duration-150 hover:bg-orange-hover"
          >
            Postular ahora
          </a>
          <a
            href="#que-es"
            class="border border-border text-ink font-semibold text-sm px-6 py-3 rounded-md text-center transition-colors duration-150 hover:border-entel hover:text-entel"
          >
            Conocer el programa
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-8 border-t border-border">
          <div>
            <div class="text-xs font-semibold uppercase tracking-wide text-muted mb-1">Inicio postulaciones</div>
            <div class="text-base font-semibold text-ink">18 de mayo, 2026</div>
          </div>
          <div>
            <div class="text-xs font-semibold uppercase tracking-wide text-muted mb-1">Cupos Senior</div>
            <div class="text-base font-semibold text-ink">500 · 55 a 70 años</div>
          </div>
          <div>
            <div class="text-xs font-semibold uppercase tracking-wide text-muted mb-1">Cupos Jóvenes</div>
            <div class="text-base font-semibold text-ink">80 · 18 a 30 años</div>
          </div>
        </div>
      </div>

      <!-- Columna menor (1) — imagen -->
      <div class="relative flex justify-center lg:justify-end">
        <img
          src="/dupla-tech.png"
          alt="Dupla intergeneracional trabajando con tecnología"
          class="w-full max-w-md h-auto object-contain"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>
