---
interface Props {
  variant?: "default" | "junior" | "senior";
}

const { variant = "default" } = Astro.props;

const content = {
  default: {
    badge: "Alianza Entel + Desafío Latam · 2026",
    badgeColor: "text-entel bg-entel/8",
    title: 'Duplas <strong class="font-bold text-entel">Intergeneracionales</strong> Tech',
    subtitle: 'Programa <strong class="text-ink">100% gratuito</strong> para potenciar tu empleabilidad y dominar la Inteligencia Artificial. Conecta con otras generaciones, financiado por el Fondo 55+ Entel.',
    ctaPrimary: "Postular ahora",
    ctaPrimaryHref: "#postulacion",
    stats: [
      { label: "Inicio postulaciones", val: "18 de mayo, 2026" },
      { label: "Cupos Senior", val: "750 · 55 a 70 años" },
      { label: "Cupos Jóvenes", val: "80 · 18 a 30 años" },
    ],
  },
  senior: {
    badge: "Profesional Senior · 55 a 70 años",
    badgeColor: "text-entel bg-entel/8",
    title: 'Tu experiencia + <strong class="font-bold text-entel">IA</strong> = nueva oportunidad',
    subtitle: 'Programa <strong class="text-ink">100% gratuito</strong> para profesionales con experiencia que quieren actualizarse, dominar la IA y mejorar su posicionamiento profesional. Financiado por el Fondo 55+ Entel.',
    ctaPrimary: "Postular como Senior",
    ctaPrimaryHref: "#postulacion",
    stats: [
      { label: "Cupos disponibles", val: "750 profesionales Senior" },
      { label: "Inicio postulaciones", val: "18 de mayo, 2026" },
      { label: "Modalidad Etapa 1", val: "100% online · 8 webinars" },
    ],
  },
  junior: {
    badge: "Joven Colaborador · 18 a 30 años",
    badgeColor: "text-orange bg-orange/10",
    title: 'Co-crea con un mentor senior y <strong class="font-bold text-orange">construye tu carrera</strong>',
    subtitle: 'Programa <strong class="text-ink">100% gratuito</strong> para jóvenes apasionados por la tecnología que quieren formar equipo con profesionales con experiencia, prototipar con IA y conectarse con +20 empresas. Financiado por el Fondo 55+ Entel.',
    ctaPrimary: "Postular como Joven",
    ctaPrimaryHref: "#postulacion",
    stats: [
      { label: "Cupos disponibles", val: "80 jóvenes colaboradores" },
      { label: "Inicio postulaciones", val: "18 de mayo, 2026" },
      { label: "Vibecoding", val: "Cursor, Replit, v0, Lovable" },
    ],
  },
};

const c = content[variant];
---

<section id="inicio" class="bg-white border-b border-border">
  <div class="max-w-300 mx-auto px-6 sm:px-8 lg:px-12 py-16 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-[1.618fr_1fr] gap-12 lg:gap-16 items-center">
      <div>
        <div class={`inline-flex items-center gap-2 text-xs font-semibold px-3 py-1.5 rounded-full mb-6 ${c.badgeColor}`}>
          {c.badge}
        </div>

        <h1 class="font-semibold text-3xl md:text-4xl lg:text-5xl text-ink leading-tight mb-5" set:html={c.title}></h1>

        <p class="text-base lg:text-lg text-muted leading-relaxed mb-8 max-w-2xl" set:html={c.subtitle}></p>

        <div class="flex flex-col sm:flex-row gap-4 mb-10">
          <a
            href={c.ctaPrimaryHref}
            class="bg-orange text-white font-semibold text-sm px-6 py-3 rounded-md text-center transition-colors duration-150 hover:bg-orange-hover"
          >
            {c.ctaPrimary}
          </a>
          <a
            href="#que-es"
            class="border border-border text-ink font-semibold text-sm px-6 py-3 rounded-md text-center transition-colors duration-150 hover:border-entel hover:text-entel"
          >
            Conocer el programa
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-8 border-t border-border">
          {
            c.stats.map(({ label, val }) => (
              <div>
                <div class="text-xs font-semibold uppercase tracking-wide text-muted mb-1">{label}</div>
                <div class="text-base font-semibold text-ink">{val}</div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="relative flex justify-center lg:justify-end">
        <img
          src="/dupla-tech.png"
          alt="Dupla intergeneracional trabajando con tecnología"
          class="w-full max-w-md h-auto object-contain"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>
