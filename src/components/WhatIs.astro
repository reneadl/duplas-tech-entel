<section id="que-es" class="bg-white border-b border-border scroll-mt-16">
  <div class="max-w-300 mx-auto px-6 sm:px-8 lg:px-12 py-16 lg:py-20">
    <div class="max-w-3xl mb-12">
      <h2 class="font-semibold text-2xl lg:text-3xl text-ink leading-tight mb-4">
        Una iniciativa de <strong class="font-bold text-entel">Desafío Latam</strong> apoyada por <strong class="font-bold text-entel">Entel</strong>
      </h2>
      <p class="text-base text-muted leading-relaxed mb-3">
        Diseñada para unir la experiencia de profesionales Senior con la innovación de Jóvenes Talentos. A través del uso de la Inteligencia Artificial y metodologías ágiles, fortalecerás tu autonomía digital y tus oportunidades en el mercado laboral.
      </p>
      <p class="text-sm text-muted">
        Con apoyo de <strong class="text-ink">Huechuraba Capacita</strong>.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {
        beneficios.map(({ title, desc, icon }) => (
          <div class="flex items-center gap-5 bg-soft border border-border rounded-xl p-5">
            <svg class="shrink-0 w-12 h-12 text-orange [filter:drop-shadow(0_0_8px_rgba(255,61,0,0.55))]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d={icon} />
            </svg>
            <div class="min-w-0">
              <div class="font-semibold text-ink text-sm mb-1">{title}</div>
              <div class="text-sm text-muted leading-relaxed">{desc}</div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
