---
const beneficios = [
  { label: "100% gratuito", desc: "Financiado por el Fondo 55+ Entel" },
  { label: "Enfoque en IA", desc: "ChatGPT, Gemini, Cursor, v0 y más" },
  { label: "Duplas reales", desc: "Senior + Joven trabajando en equipo" },
  { label: "Certificación oficial", desc: "Conjunta Entel + Desafío Latam" },
];
---

<section id="que-es" class="bg-soft border-b border-border scroll-mt-16">
  <div class="max-w-300 mx-auto px-6 sm:px-8 lg:px-12 py-16 lg:py-20">
    <div class="max-w-3xl mb-10">
      <div class="text-xs font-semibold uppercase tracking-wide text-orange mb-3">El programa</div>
      <h2 class="font-bold text-2xl lg:text-3xl text-ink leading-tight mb-4">
        Una iniciativa de Desafío Latam apoyada por Entel
      </h2>
      <p class="text-base text-muted leading-relaxed mb-3">
        Diseñada para unir la experiencia de profesionales Senior con la innovación de Jóvenes Talentos. A través del uso de la Inteligencia Artificial y metodologías ágiles, fortalecerás tu autonomía digital y tus oportunidades en el mercado laboral.
      </p>
      <p class="text-sm text-muted">
        Con apoyo de <strong class="text-ink">Huechuraba Capacita</strong>.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {
        beneficios.map(({ label, desc }) => (
          <div class="bg-white border border-border rounded-md p-5">
            <div class="font-semibold text-ink text-sm mb-1">{label}</div>
            <div class="text-sm text-muted leading-relaxed">{desc}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>
