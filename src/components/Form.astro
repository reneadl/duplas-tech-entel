---
interface Props {
  perfil?: "senior" | "joven" | null;
}

const { perfil = null } = Astro.props;

const regiones = [
  "Región Metropolitana",
  "Valparaíso",
  "Otra región",
];

const niveles = [
  "Enseñanza Media Completa",
  "Técnico Profesional",
  "Universitaria Incompleta",
  "Universitaria Completa",
  "Postgrado",
];

const situaciones = [
  "Empleado/a dependiente",
  "Independiente / Freelance",
  "Buscando empleo activamente",
  "Jubilado/a",
  "Otro",
];

const generos = [
  "Femenino",
  "Masculino",
  "No binario",
  "Prefiero no decirlo",
];

const inputClass = "w-full px-3 py-2.5 border border-border rounded-md text-sm bg-white focus:outline-none focus:border-entel focus:ring-1 focus:ring-entel transition-colors";
const labelClass = "block text-sm font-semibold text-ink mb-1.5";

const perfilData = {
  senior: { nombre: "Profesional Senior", edad: "55 a 70 años", color: "bg-entel" },
  joven: { nombre: "Joven Colaborador", edad: "18 a 30 años", color: "bg-orange" },
};

const showSelector = perfil === null;
const initial = perfil ? perfilData[perfil] : null;
---

<section id="postulacion" class="bg-soft border-b border-border scroll-mt-16">
  <div class="max-w-300 mx-auto px-6 sm:px-8 lg:px-12 py-16 lg:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-16 items-start">
      <div class="lg:col-span-2 lg:sticky lg:top-24">
        <div class="text-xs font-semibold uppercase tracking-wide text-orange mb-3">Postulación</div>
        <h2 class="font-bold text-2xl lg:text-3xl text-ink leading-tight mb-4">
          Da el primer paso
        </h2>
        <p class="text-base text-muted leading-relaxed mb-6">
          {showSelector
            ? "Selecciona tu perfil y completa el formulario. Una vez cerrado el proceso, te contactaremos con los resultados de la selección."
            : "Completa el formulario. Una vez cerrado el proceso, te contactaremos con los resultados de la selección."}
        </p>

        <div class="border border-border rounded-md divide-y divide-border bg-white">
          {
            [
              { label: "Apertura", val: "18 de mayo, 2026" },
              { label: "Cierre", val: "31 de mayo, 2026" },
              { label: "Inicio Etapa 1", val: "Junio, 2026" },
            ].map(({ label, val }) => (
              <div class="flex items-center justify-between gap-4 px-4 py-3">
                <span class="text-xs font-semibold uppercase tracking-wide text-muted">{label}</span>
                <span class="text-sm font-semibold text-ink">{val}</span>
              </div>
            ))
          }
        </div>
      </div>

      <div class="lg:col-span-3">
        {showSelector && (
          <div id="perfilSelector" class="bg-white border border-border rounded-md p-6 lg:p-10">
            <div class="text-center mb-8">
              <h3 class="font-bold text-xl lg:text-2xl text-ink mb-2">¿A qué perfil postulas?</h3>
              <p class="text-sm text-muted">Selecciona una opción para continuar</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <button
                type="button"
                data-perfil="senior"
                class="group bg-entel hover:bg-entel-deep text-white p-6 lg:p-8 rounded-md text-left transition-colors duration-150"
              >
                <div class="text-xs font-semibold uppercase tracking-wide text-white/70 mb-3">Profesional</div>
                <div class="font-bold text-2xl lg:text-3xl mb-1">Senior</div>
                <div class="text-sm text-white/85 mb-6">55 a 70 años</div>
                <div class="flex items-center gap-2 text-sm font-semibold">
                  Postular como Senior
                  <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                  </svg>
                </div>
              </button>

              <button
                type="button"
                data-perfil="joven"
                class="group bg-orange hover:bg-orange-hover text-white p-6 lg:p-8 rounded-md text-left transition-colors duration-150"
              >
                <div class="text-xs font-semibold uppercase tracking-wide text-white/80 mb-3">Joven</div>
                <div class="font-bold text-2xl lg:text-3xl mb-1">Colaborador</div>
                <div class="text-sm text-white/90 mb-6">18 a 30 años</div>
                <div class="flex items-center gap-2 text-sm font-semibold">
                  Postular como Joven
                  <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                  </svg>
                </div>
              </button>
            </div>
          </div>
        )}

        <form
          id="postulacionForm"
          action="/success"
          method="post"
          class:list={["bg-white border border-border rounded-md p-6 lg:p-8", showSelector && "hidden"]}
        >
          <input type="hidden" name="perfil" id="perfilHidden" value={perfil ?? ""} />

          <div class="flex items-center justify-between gap-4 mb-6 pb-6 border-b border-border">
            <div class="flex items-center gap-3">
              <span
                id="perfilBadge"
                class:list={[
                  "text-xs font-semibold uppercase tracking-wide text-white px-3 py-1.5 rounded-full",
                  initial?.color ?? "",
                ]}
              >
                {initial?.nombre ?? ""}
              </span>
              <span id="perfilLabel" class="text-sm font-semibold text-ink">
                {initial?.edad ?? ""}
              </span>
            </div>
            {showSelector && (
              <button type="button" id="cambiarPerfil" class="text-sm font-semibold text-muted hover:text-ink transition-colors flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Cambiar
              </button>
            )}
          </div>

          <div class="flex flex-col gap-5">
            <div>
              <label for="nombre" class={labelClass}>Nombre completo *</label>
              <input id="nombre" name="nombre" type="text" required class={inputClass} />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="rut" class={labelClass}>RUT / DNI *</label>
                <input id="rut" name="rut" type="text" required placeholder="12.345.678-9" class={inputClass} />
              </div>
              <div>
                <label for="nacimiento" class={labelClass}>Fecha de nacimiento *</label>
                <input id="nacimiento" name="nacimiento" type="date" required class={inputClass} />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="genero" class={labelClass}>Género</label>
                <select id="genero" name="genero" class={inputClass}>
                  <option value="">Selecciona...</option>
                  {generos.map((g) => <option value={g}>{g}</option>)}
                </select>
              </div>
              <div>
                <label for="telefono" class={labelClass}>Teléfono *</label>
                <input id="telefono" name="telefono" type="tel" required placeholder="+56 9 ..." class={inputClass} />
              </div>
            </div>

            <div>
              <label for="email" class={labelClass}>Correo electrónico *</label>
              <input id="email" name="email" type="email" required placeholder="tu@correo.com" class={inputClass} />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="region" class={labelClass}>Región *</label>
                <select id="region" name="region" required class={inputClass}>
                  <option value="">Selecciona...</option>
                  {regiones.map((r) => <option value={r}>{r}</option>)}
                </select>
              </div>
              <div>
                <label for="comuna" class={labelClass}>Comuna *</label>
                <input id="comuna" name="comuna" type="text" required class={inputClass} />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="nivel" class={labelClass}>Nivel educacional *</label>
                <select id="nivel" name="nivel" required class={inputClass}>
                  <option value="">Selecciona...</option>
                  {niveles.map((n) => <option value={n}>{n}</option>)}
                </select>
              </div>
              <div>
                <label for="situacion" class={labelClass}>Situación laboral</label>
                <select id="situacion" name="situacion" class={inputClass}>
                  <option value="">Selecciona...</option>
                  {situaciones.map((s) => <option value={s}>{s}</option>)}
                </select>
              </div>
            </div>

            <div>
              <label for="linkedin" class={labelClass}>URL o usuario de LinkedIn *</label>
              <input id="linkedin" name="linkedin" type="text" required placeholder="https://linkedin.com/in/..." class={inputClass} />
            </div>

            <fieldset>
              <legend class={labelClass}>¿Tienes manejo fluido de computador? *</legend>
              <p class="text-xs text-muted mb-2">El programa no es de alfabetización digital inicial.</p>
              <div class="grid grid-cols-2 gap-3">
                <label class="flex items-center gap-2 p-3 border border-border rounded-md cursor-pointer has-[:checked]:border-entel has-[:checked]:bg-entel/5 transition-colors">
                  <input type="radio" name="manejo" value="si" required class="accent-entel" />
                  <span class="text-sm text-ink font-medium">Sí, manejo fluido</span>
                </label>
                <label class="flex items-center gap-2 p-3 border border-border rounded-md cursor-pointer has-[:checked]:border-orange has-[:checked]:bg-orange/5 transition-colors">
                  <input type="radio" name="manejo" value="no" class="accent-orange" />
                  <span class="text-sm text-ink font-medium">No</span>
                </label>
              </div>
            </fieldset>

            <div>
              <label for="ia" class={labelClass}>¿Conocimientos previos en IA o herramientas digitales?</label>
              <p class="text-xs text-muted mb-1.5">No excluyente. Cuéntanos brevemente.</p>
              <textarea id="ia" name="ia" rows="3" class={inputClass + " resize-y"}></textarea>
            </div>

            <label class="flex items-start gap-2 text-sm text-muted leading-relaxed">
              <input type="checkbox" name="terminos" required class="mt-1 accent-orange" />
              <span>Acepto el tratamiento de mis datos personales para fines de selección y comunicación del programa.</span>
            </label>

            <button type="submit"
              class="bg-orange text-white font-semibold text-sm px-6 py-3 rounded-md transition-colors duration-150 hover:bg-orange-hover">
              Enviar postulación
            </button>

            <p class="text-center text-xs text-muted">
              Una iniciativa de Desafío Latam · Fondo 55+ Entel 2026 · Apoya: Huechuraba Capacita
            </p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

{showSelector && (
  <script>
    const selector = document.getElementById("perfilSelector")!;
    const form = document.getElementById("postulacionForm")!;
    const hidden = document.getElementById("perfilHidden") as HTMLInputElement;
    const badge = document.getElementById("perfilBadge")!;
    const label = document.getElementById("perfilLabel")!;
    const cambiar = document.getElementById("cambiarPerfil")!;

    const perfiles = {
      senior: { nombre: "Profesional Senior", edad: "55 a 70 años", color: "bg-entel" },
      joven: { nombre: "Joven Colaborador", edad: "18 a 30 años", color: "bg-orange" },
    } as const;

    document.querySelectorAll<HTMLButtonElement>("[data-perfil]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const perfil = btn.dataset.perfil as keyof typeof perfiles;
        const data = perfiles[perfil];

        hidden.value = perfil;
        badge.textContent = data.nombre;
        badge.className = `text-xs font-semibold uppercase tracking-wide text-white px-3 py-1.5 rounded-full ${data.color}`;
        label.textContent = data.edad;

        selector.classList.add("hidden");
        form.classList.remove("hidden");
        form.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    cambiar.addEventListener("click", () => {
      form.classList.add("hidden");
      selector.classList.remove("hidden");
      hidden.value = "";
      selector.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
)}
