---
const hitos = [
  { date: "18 May 2026", title: "Inicio de convocatoria", desc: "Postulaciones abiertas hasta el 31 de mayo." },
  { date: "Jun – Jul 2026", title: "Etapa 1 · Bootcamp", desc: "8 webinars de Empleabilidad e IA, 100% online." },
  { date: "Mediados de Jul 2026", title: "Selección y matching", desc: "Se forman las 60 Duplas Intergeneracionales." },
  { date: "Jul – Sep 2026", title: "Etapa 2 · Vibecoding", desc: "Trabajo en duplas, prototipado y mentorías." },
  { date: "Fines de Sep 2026", title: "Demo Day y certificación", desc: "Showcase Silver Tech con +20 empresas." },
];
---

<section id="cronograma" class="bg-white border-b border-border scroll-mt-16">
  <div class="max-w-300 mx-auto px-6 sm:px-8 lg:px-12 py-16 lg:py-20">
    <div class="text-center max-w-2xl mx-auto mb-12 lg:mb-16">
      <div class="text-xs font-semibold uppercase tracking-wide text-orange mb-3">Cronograma</div>
      <h2 class="font-semibold text-2xl lg:text-3xl text-ink leading-tight mb-3">
        Fechas <strong class="font-bold text-entel">clave</strong> 2026
      </h2>
      <p class="text-base text-muted leading-relaxed">
        De mayo a septiembre. Reserva las fechas y acompáñanos en cada hito.
      </p>
    </div>

    <div class="relative">
      <!-- Línea conectora horizontal (desktop) -->
      <div class="hidden lg:block absolute top-8 left-[10%] right-[10%] h-0.5 bg-border"></div>

      <ol class="relative grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-4">
        {
          hitos.map(({ date, title, desc }, i) => (
            <li class="relative text-center px-2">
              <div class="relative z-10 mx-auto w-16 h-16 rounded-full bg-entel text-white flex items-center justify-center font-bold text-2xl mb-4 shadow-md">
                {i + 1}
              </div>
              <div class="text-xs font-semibold uppercase tracking-wide text-orange mb-1.5">{date}</div>
              <div class="font-semibold text-sm text-ink mb-1.5 leading-tight">{title}</div>
              <div class="text-sm text-muted leading-relaxed">{desc}</div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
