---
const requisitos = [
  "Chilenos o extranjeros residentes en Chile",
  "Enseñanza Media Completa o Superior",
  "Manejo básico de herramientas digitales y dispositivos",
  "Foco en Región Metropolitana y Valparaíso (hitos presenciales)",
];
---

<section id="dirigido" class="bg-white border-b border-border scroll-mt-16">
  <div class="max-w-300 mx-auto px-6 sm:px-8 lg:px-12 py-16 lg:py-20">
    <div class="max-w-3xl mb-10">
      <div class="text-xs font-semibold uppercase tracking-wide text-orange mb-3">A quién va dirigido</div>
      <h2 class="font-bold text-2xl lg:text-3xl text-ink leading-tight">
        Dos perfiles, una misma misión
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
      <div class="bg-white border border-border rounded-md p-6 lg:p-8">
        <div class="text-xs font-semibold uppercase tracking-wide text-entel mb-3">Perfil Senior</div>
        <div class="flex items-baseline gap-2 mb-3">
          <span class="font-bold text-4xl text-ink">500</span>
          <span class="text-sm text-muted">cupos</span>
        </div>
        <h3 class="font-semibold text-lg text-ink mb-2">Profesionales Senior</h3>
        <p class="text-sm text-muted leading-relaxed">
          <strong class="text-ink">55 a 70 años.</strong> Personas con experiencia que deseen actualizarse, aprender sobre IA y mejorar su posicionamiento profesional.
        </p>
      </div>

      <div class="bg-white border border-border rounded-md p-6 lg:p-8">
        <div class="text-xs font-semibold uppercase tracking-wide text-orange mb-3">Perfil Joven</div>
        <div class="flex items-baseline gap-2 mb-3">
          <span class="font-bold text-4xl text-ink">80</span>
          <span class="text-sm text-muted">cupos</span>
        </div>
        <h3 class="font-semibold text-lg text-ink mb-2">Jóvenes Colaboradores</h3>
        <p class="text-sm text-muted leading-relaxed">
          <strong class="text-ink">18 a 30 años.</strong> Apasionados por la tecnología dispuestos a formar equipo, co-crear soluciones y compartir conocimientos.
        </p>
      </div>
    </div>

    <div class="bg-white border border-border rounded-md p-6 lg:p-8">
      <div class="text-xs font-semibold uppercase tracking-wide text-orange mb-3">Requisitos generales</div>
      <h3 class="font-semibold text-lg text-ink mb-5">Para ambos perfiles</h3>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-5">
        {
          requisitos.map((item) => (
            <li class="flex items-start gap-2 text-sm text-ink leading-relaxed">
              <svg class="w-4 h-4 text-entel mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              {item}
            </li>
          ))
        }
      </ul>
      <p class="text-sm text-muted pt-4 border-t border-border">
        <strong class="text-ink">Importante:</strong> Este programa está orientado a la especialización técnica y uso de IA, no es un curso de alfabetización digital inicial.
      </p>
    </div>
  </div>
</section>
