---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Postulación recibida">
  <main class="min-h-screen bg-white flex items-center justify-center px-6 py-16">
    <div class="max-w-lg w-full bg-white border border-border rounded-md p-8 lg:p-10 text-center">
      <div class="w-14 h-14 mx-auto mb-5 rounded-full bg-entel/10 flex items-center justify-center">
        <svg class="w-7 h-7 text-entel" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
      <h1 class="font-bold text-2xl lg:text-3xl text-ink mb-3">Postulación recibida</h1>
      <p class="text-base text-muted leading-relaxed mb-8">
        Gracias por sumarte al programa <strong class="text-ink">Duplas Intergeneracionales Tech</strong>. Hemos recibido tus datos. Te contactaremos por correo con los resultados del proceso de selección.
      </p>
      <a href="/" class="inline-block bg-orange text-white font-semibold text-sm px-6 py-3 rounded-md hover:bg-orange-hover transition-colors">
        Volver al inicio
      </a>
    </div>
  </main>
</Layout>
