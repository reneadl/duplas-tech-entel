---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const {
  title = 'Duplas Intergeneracionales Tech',
  description = 'Programa gratuito impulsado por Desafío Latam con apoyo de Entel y Huechuraba Capacita. Potencia tu empleabilidad y domina la Inteligencia Artificial junto a otras generaciones.',
  image = '/og.jpg',
  canonical = Astro.url.href,
} = Astro.props;

const fullTitle = title === 'Duplas Intergeneracionales Tech'
  ? `${title} | Entel + Desafío Latam`
  : `${title} | Duplas Tech`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOccupationalProgram',
  name: 'Duplas Intergeneracionales Tech',
  description,
  provider: {
    '@type': 'Organization',
    name: 'Desafío Latam',
    url: 'https://desafiolatam.com',
  },
  sponsor: {
    '@type': 'Organization',
    name: 'Entel',
  },
  educationalProgramMode: 'online',
  programType: 'Bootcamp',
  occupationalCategory: 'Tech',
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="Duplas Tech" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Structured data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
